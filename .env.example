# ============================================================
# Unick Auto Detailing — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# ============================================================

# ------------------------------------------------------------
# AI Assistant (Optional)
# Get your key at: https://aistudio.google.com/app/apikey
# If not set, the AI Assistant runs in simulated mode.
# ------------------------------------------------------------
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------
# Admin Panel
# Set a strong password for the admin dashboard.
# Default is set inside the app — override here if needed.
# ------------------------------------------------------------
VITE_ADMIN_PASSWORD=your_secure_admin_password_here
